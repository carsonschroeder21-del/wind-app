# Copy this file to .env and fill in real values. .env is gitignored — never commit
# real API keys.

# Google Maps API key (Maps SDK for Android + Maps SDK for iOS enabled), used to render
# the interactive map on the Stand screen. See README.md "Google Maps setup" for how to
# create and restrict this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Supabase project URL + anon (public) key, used for cloud sync (hunt log / thermal log
# backup, and the opt-in anonymized training dataset). EXPO_PUBLIC_ prefix means Metro
# inlines these at build time — the anon key is safe to ship in the client; it's meant to
# be public and every table it can reach is locked down with row-level security (see
# supabase/schema.sql). See README.md "Cloud sync setup" for how to create the project
# and run the schema. Leave blank to build/run without cloud sync (it degrades to
# local-only, same as leaving GOOGLE_MAPS_API_KEY blank degrades the map).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
